{
  "name": "o-hochu",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:api": "python -m uvicorn services.search_api.main:app --host 127.0.0.1 --port 8000",
    "dev:all": "powershell -ExecutionPolicy Bypass -File scripts/start-dev.ps1",
    "dev:lan": "vite --host --port 5173 --strictPort",
    "setup:catalog": "python -m services.catalog.import_curated_hotels",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/smoke.spec.ts e2e/checkout.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort"
  },
  "dependencies": {
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.52.0",
    "maplibre-gl": "^6.19.0",
    "react": "^19.3.1",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
