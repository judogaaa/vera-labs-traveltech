# Local demo (no Qdrant / no services.indexer): use mock
SEARCH_BACKEND=mock
# Cloud visual search requires Qdrant + optional services/indexer checkout
# SEARCH_BACKEND=cloud
QDRANT_URL=
QDRANT_API_KEY=

QDRANT_COLLECTION_IDENTITY=hotel_identity_resnetv2_10k
QDRANT_COLLECTION_SIMILARITY=hotel_similarity
IDENTITY_ENCODER=hotels50k-official
EMBEDDING_MODEL_ID=
# Frontend → API (must match uvicorn host/port)
VITE_VISUAL_SEARCH_API_URL=http://127.0.0.1:8000

# ─── О!Подбор (hotel intelligence addon) ───
# SQLite evidence store + demo region payload (Istanbul by default).
# DEMO_MODE defaults OFF in code; enable only for local hackathon demos.
# Writes require a unique, high-entropy server-side token. Never use a fixed example password.
# For local-only interactive demos, set DEMO_MODE=1 and generate a random token.
HOTEL_INTELLIGENCE_DB=data/ostrovok_demo/intelligence.sqlite
HOTEL_INTELLIGENCE_DEMO_DIR=data/ostrovok_demo
HOTEL_INTELLIGENCE_DEMO_MODE=0
HOTEL_INTELLIGENCE_WRITE_TOKEN=
HOTEL_INTELLIGENCE_ENRICH_MAX_PER_MIN=10
HOTEL_INTELLIGENCE_PREFER_LOCAL_OSM=1
# NEVER put WRITE_TOKEN in VITE_* — it would ship to the browser.
# Local demo UI gets an HttpOnly cookie via POST /api/hotel-intelligence/demo/session
# (loopback + DEMO_MODE only). Scripts/tests use X-Write-Token header.
# HOTEL_INTELLIGENCE_OSM_TIMEOUT=25
# HOTEL_INTELLIGENCE_USER_AGENT=vera-labs-hotel-intelligence/0.1 (demo)
# Optional: force GigaChat tool loop on every trip plan (default auto = only if few POIs)
# TRIP_GIGACHAT_TOOL_LOOP=auto

# ─── О!Маршрут (AI trip planner) ───
TRIP_GEOCODING_PROVIDER=nominatim
TRIP_PLACES_PROVIDER=overpass
TRIP_ROUTING_PROVIDER=osrm
NOMINATIM_URL=https://nominatim.openstreetmap.org
OVERPASS_URL=https://overpass-api.de/api/interpreter
OSRM_URL=https://router.project-osrm.org
TRIP_PLANNER_USER_AGENT=o-hochu-trip-planner/1.0 (vera-labs)
TRIP_STORE_DIR=data/trips
TRIP_ALLOW_FIXTURES=0

OPENROUTESERVICE_API_KEY=
GOOGLE_MAPS_API_KEY=
YANDEX_MAPS_API_KEY=

# ─── GigaChat (backend only — NEVER use VITE_ prefix) ───
# Authorization key = Base64(client_id:client_secret) from Sber developers console
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_BASE_URL=https://api.giga.chat
GIGACHAT_MODEL=
GIGACHAT_ENABLED=false
# Combined certifi + Russian Trusted Root CA (see docs/GIGACHAT_SETUP.md)
GIGACHAT_CA_BUNDLE=
# Diagnostic only — never enable in production
GIGACHAT_TLS_INSECURE=0
